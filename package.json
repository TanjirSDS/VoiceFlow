{
  "name": "voiceflow",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:verify": "bash scripts/verify-migrations.sh",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "outbound-test": "tsx scripts/outbound-test.ts",
    "seed-calls": "tsx scripts/seed-calls.ts",
    "seed-demo": "tsx scripts/seed-demo.ts",
    "seed-orgs": "tsx scripts/seed-orgs.ts",
    "stripe-setup": "tsx scripts/stripe-setup.ts",
    "stripe-acceptance": "tsx scripts/stripe-acceptance.ts",
    "seed-admin": "tsx scripts/seed-admin.ts",
    "seed-learning": "tsx scripts/seed-learning.ts",
    "migrate-agent-config": "tsx scripts/migrate-agent-config.ts",
    "backfill-contacts": "tsx scripts/backfill-contacts.ts",
    "migrate-numbers": "tsx scripts/migrate-numbers-to-subaccounts.ts",
    "verify-isolation": "tsx scripts/verify-subaccount-isolation.ts"
  },
  "dependencies": {
    "@voiceflow/db": "*",
    "@voiceflow/engine": "*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8",
    "@typescript-eslint/parser": "^8.63.0",
    "dotenv": "^16",
    "eslint": "^9.39.5",
    "pg": "^8",
    "tsx": "^4",
    "turbo": "^2",
    "typescript": "^5",
    "vitest": "^3"
  },
  "packageManager": "npm@10.8.2"
}
