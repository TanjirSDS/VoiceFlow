# Copy to .env.local and fill in real values. Validated by packages/db/src/env.ts (zod).
ELEVENLABS_API_KEY=sk_your_elevenlabs_api_key
ELEVENLABS_WEBHOOK_SECRET=wsec_your_webhook_secret
# Simultaneous calls your ElevenLabs plan allows, shared across all tenants
# (Pro 20, Scale 30, Business 40). Defaults to 20. Bump it when you upgrade.
ELEVENLABS_MAX_CONCURRENCY=20
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Database (Phase 21: Railway Postgres + our own PostgREST). Defaults below
# match docker-compose.yml — `docker compose up -d && npm run migrate`.
# Railway: DATABASE_URL=${{Postgres.DATABASE_URL}} (reference variable),
# POSTGREST_URL=http://postgrest.railway.internal:3000 (private network).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
POSTGREST_URL=http://127.0.0.1:54321
# Same value on the PostgREST service as PGRST_JWT_SECRET. ≥32 chars.
POSTGREST_JWT_SECRET=local-dev-postgrest-jwt-secret-32-chars-min
# PostgREST's login password; `npm run migrate` sets it on the authenticator
# role every deploy. Same value inside the PostgREST service's PGRST_DB_URI.
POSTGREST_DB_PASSWORD=local-authenticator-password
# Signs session cookies. ≥32 chars: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=generate-a-long-random-string-32-chars-min

# Stripe billing (Phase 5)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Phase 6 — all optional (features degrade gracefully without them)
# Transactional email (magic links, welcome, cap warnings, dunning, weekly
# summary). REQUIRED in production — sign-in links go out through it. Without
# it in dev, the magic link is printed to the `next dev` log instead.
RESEND_API_KEY=re_...
EMAIL_FROM="VoiceFlow <hello@yourdomain.com>"
# Absolute origin: email links AND Better Auth's baseURL (cookie + CSRF origin).
APP_URL=https://app.yourdomain.com
# Inngest (async jobs: classification, reconcile, status poll, emails).
# Prod: copy both keys from the Inngest dashboard; sync the app at
# https://<railway domain>/api/inngest. Local: `npx inngest-cli dev` + INNGEST_DEV=1.
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=signkey-...
# Upstash rate limiting (auth + webhook routes). Absent = no limiting.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=...
# Sentry: server (SENTRY_DSN above the fold if unset) and browser.
SENTRY_DSN=https://...@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# Manual-trigger secret for /api/cron/reconcile (route refuses without it).
CRON_SECRET=generate-a-long-random-string
