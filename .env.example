# Copy to .env.local and fill in real values. Validated by packages/db/src/env.ts (zod).
ELEVENLABS_API_KEY=sk_your_elevenlabs_api_key
ELEVENLABS_WEBHOOK_SECRET=wsec_your_webhook_secret
# Simultaneous calls your ElevenLabs plan allows, shared across all tenants
# (Pro 20, Scale 30, Business 40). Defaults to 20. Bump it when you upgrade.
ELEVENLABS_MAX_CONCURRENCY=20
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Phase 23: seals each org's Twilio subaccount auth token at rest (AES-256-GCM).
# Required. Generate with:  openssl rand -base64 32
# Rotating it is safe: the parent Twilio account can re-fetch every subaccount
# token, so a lost key is recoverable (see resealFromTwilio()).
CREDENTIAL_ENCRYPTION_KEY=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Direct Postgres connection — only `npm run migrate` uses it, not the app.
# Supabase dashboard → Project Settings → Database → Connection string → URI.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.your-project.supabase.co:5432/postgres

# Stripe billing (Phase 5)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Phase 6 — all optional (features degrade gracefully without them)
# Transactional email (welcome, cap warnings, dunning, weekly summary).
# Magic-link emails go through Supabase Auth: set Resend as the project's SMTP
# (dashboard → Auth → SMTP: host smtp.resend.com, user "resend", pass = API key)
# and customize the magic-link template there.
RESEND_API_KEY=re_...
EMAIL_FROM="VoiceFlow <hello@yourdomain.com>"
# Absolute origin used inside email links.
APP_URL=https://app.yourdomain.com
# Inngest (async jobs: classification, reconcile, status poll, emails).
# Prod: install the Inngest Vercel integration (sets these). Local: `npx inngest-cli dev` + INNGEST_DEV=1.
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=signkey-...
# Upstash rate limiting (auth + webhook routes). Absent = no limiting.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=...
# Sentry: server (SENTRY_DSN above the fold if unset) and browser.
SENTRY_DSN=https://...@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0
# Manual-trigger secret for /api/cron/reconcile (route refuses without it).
CRON_SECRET=generate-a-long-random-string
